{
  "name": "lambder",
  "version": "4.7.1",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "browser": {
    "fs": false,
    "path": false,
    "zlib": false,
    "crypto": false
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "lint": "eslint . --ext .ts,.tsx --fix"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nesovera/lambder.git"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "js-cookie": "^3.0.5",
    "lru-cache": "^11.5.2",
    "mime-types": "^2.1.35",
    "path-to-regexp": "^6.2.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.574.0",
    "@aws-sdk/client-s3": "^3.574.0",
    "@aws-sdk/lib-dynamodb": "^3.574.0",
    "msw": "^2.0.0",
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.913.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.913.0",
    "@types/aws-lambda": "^8.10.136",
    "@types/cookie": "^0.6.0",
    "@types/js-cookie": "^3.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.19.22",
    "@types/path-to-regexp": "^1.7.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
