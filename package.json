{
  "name": "lambder",
  "version": "7.1.4",
  "sideEffects": false,
  "description": "Opinionated serverless web framework for TypeScript on AWS Lambda: type-safe APIs from Zod schemas, DynamoDB sessions, and declarative rate limits, authorization guards and idempotency.",
  "keywords": [
    "lambda",
    "aws-lambda",
    "serverless",
    "framework",
    "typescript",
    "api",
    "zod",
    "type-safe",
    "rest",
    "api-gateway",
    "dynamodb",
    "session",
    "rate-limit",
    "idempotency",
    "guards",
    "msw",
    "i18n",
    "templating"
  ],
  "homepage": "https://github.com/nesovera/lambder#readme",
  "bugs": {
    "url": "https://github.com/nesovera/lambder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesovera/lambder.git"
  },
  "license": "MIT",
  "author": "NesoVera",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "mock": [
        "./dist/mock.d.ts"
      ]
    }
  },
  "browser": {
    "fs": false,
    "path": false,
    "zlib": false,
    "crypto": false
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run typecheck && npm run lint && npm run build && vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.136",
    "cookie": "^1.0.2",
    "js-cookie": "^3.0.5",
    "lru-cache": "^11.5.2",
    "mime-types": "^2.1.35",
    "path-to-regexp": "^6.2.1",
    "tough-cookie": "^6.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.574.0",
    "@aws-sdk/client-lambda": "^3.574.0",
    "@aws-sdk/client-s3": "^3.574.0",
    "@aws-sdk/lib-dynamodb": "^3.574.0",
    "msw": "^2.0.0",
    "zod": "^4.6.2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-lambda": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.913.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.913.0",
    "@types/js-cookie": "^3.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.9.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.0",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  }
}
